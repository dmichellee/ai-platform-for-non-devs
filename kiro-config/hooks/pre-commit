#!/bin/sh
# AppHub 배포 표준 pre-commit 훅 (Kiro 배포 표준 번들)
#
# 커밋 직전에 "결정적으로 판정 가능한" 항목만 검사한다. 최종 강제는 플랫폼의 배포 전
# 검증(Dockerfile 정적 검증 + 이미지 실행 스모크)이 담당한다 — 이 훅은 미리 걸러주는 보조 수단이다.
#
# 검사 항목:
#   1. 레포 루트에 Dockerfile 존재
#   2. Dockerfile의 EXPOSE는 8080 하나만 (없음/다른 포트/8080+다른포트 → 실패, 8080/tcp 표기 허용)
#   3. Dockerfile 금지 항목 (플랫폼 검증기와 동일):
#      --privileged / /var/run/docker.sock / --network host / --cap-add / 호스트 경로 바인드 마운트
#   4. 스테이징된 텍스트 파일의 고신뢰 시크릿 패턴 2종:
#      AWS Access Key(AKIA[0-9A-Z]{16}), PEM private key 헤더(-----BEGIN ... PRIVATE KEY-----)
#
# 의존성 없음: POSIX sh + grep + git 만 사용. bash 전용 문법을 쓰지 않는다.

# 실패를 모아 마지막에 한 번에 보고한다(자동 종료 방지를 위해 set -e 미사용).
FAILED=0
REASONS=""

add_reason() {
  # 실패 사유 한 줄 추가.
  REASONS="${REASONS}  - $1
"
  FAILED=1
}

# 레포 루트(작업 트리 최상위). git 훅은 레포 루트에서 실행되지만 안전하게 계산한다.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$ROOT" ]; then
  # 훅은 git 컨텍스트에서만 의미가 있다. git이 아니면 조용히 통과(방해하지 않음).
  exit 0
fi

DOCKERFILE="$ROOT/Dockerfile"

# ── 1. Dockerfile 존재 ────────────────────────────────────────────────────────
if [ ! -f "$DOCKERFILE" ]; then
  add_reason "레포 루트에 Dockerfile이 없어요. 배포하려면 루트에 Dockerfile이 필요해요."
else
  # ── Dockerfile 정규화: 주석 줄 제거, 탭→공백 (EXPOSE/금지항목 판정용) ──────────
  # 주석(#로 시작하는 줄)은 EXPOSE 판정에서 제외한다. 금지 항목은 주석 포함 원문에서도
  # 검사한다(플랫폼 검증기가 주석 내 --privileged 힌트도 잡는 것과 정합).

  # ── 2. EXPOSE는 8080 하나만 ─────────────────────────────────────────────────
  # 주석이 아닌 EXPOSE 줄에서 포트 토큰을 뽑는다. 'EXPOSE 8080/tcp' 처럼 /tcp 표기 허용.
  # awk 없이 grep+sed 만으로 처리(POSIX 호환).
  EXPOSE_LINES=$(grep -v '^[[:space:]]*#' "$DOCKERFILE" 2>/dev/null | grep -iE '^[[:space:]]*EXPOSE[[:space:]]+')
  if [ -z "$EXPOSE_LINES" ]; then
    add_reason "Dockerfile에 EXPOSE가 없어요. 'EXPOSE 8080'을 추가하세요(플랫폼은 8080만 라우팅해요)."
  else
    # 각 EXPOSE 줄에서 EXPOSE 키워드를 지우고 포트 토큰만 남긴 뒤, /프로토콜 표기를 제거.
    # 결과: 공백으로 구분된 포트 번호 목록.
    PORTS=$(printf '%s\n' "$EXPOSE_LINES" \
      | sed -E 's/^[[:space:]]*[Ee][Xx][Pp][Oo][Ss][Ee][[:space:]]+//' \
      | tr '\t' ' ' \
      | tr ' ' '\n' \
      | sed -E 's#/.*$##' \
      | grep -E '^[0-9]+$')
    HAS_8080=0
    BAD_PORTS=""
    for p in $PORTS; do
      if [ "$p" = "8080" ]; then
        HAS_8080=1
      else
        BAD_PORTS="$BAD_PORTS $p"
      fi
    done
    if [ "$HAS_8080" -eq 0 ]; then
      add_reason "EXPOSE에 8080이 없어요(현재:$(printf '%s' "$PORTS" | tr '\n' ' ')). 'EXPOSE 8080'이 필요해요."
    fi
    if [ -n "$BAD_PORTS" ]; then
      add_reason "EXPOSE는 8080 하나만 허용돼요. 다른 포트(${BAD_PORTS# })도 EXPOSE돼 있어요 — 8080만 남기세요."
    fi
  fi

  # ── 3. 금지 항목 (플랫폼 검증기 dockerfile.py 패턴과 정합) ──────────────────────
  # 원문(주석 포함)에서 대소문자 무시로 검사.
  if grep -iqE -- '--privileged([[:space:]]|$)' "$DOCKERFILE"; then
    add_reason "특권 모드(--privileged)가 감지됐어요. 앱은 특권 없이 실행돼야 해요."
  fi
  if grep -iqE -- '/var/run/docker\.sock' "$DOCKERFILE"; then
    add_reason "도커 소켓(/var/run/docker.sock) 접근이 감지됐어요. 호스트 도커 접근은 허용되지 않아요."
  fi
  if grep -iqE -- '--network[= ]host([[:space:]]|$)' "$DOCKERFILE"; then
    add_reason "호스트 네트워크(--network host)가 감지됐어요. 격리된 네트워크에서 실행돼야 해요."
  fi
  if grep -iqE -- '--cap-add[= ]' "$DOCKERFILE"; then
    add_reason "추가 커널 권한(--cap-add)이 감지됐어요. 기본 권한만 사용해야 해요."
  fi
  # 호스트 경로 바인드 마운트: RUN --mount=type=bind,...,source=/... 또는 MOUNT type=bind source=/...
  if grep -iqE -- 'type=bind[^[:space:]]*source=/' "$DOCKERFILE"; then
    add_reason "호스트 경로 바인드 마운트가 감지됐어요. 호스트 파일시스템 마운트는 허용되지 않아요."
  fi
fi

# ── 4. 스테이징된 텍스트 파일의 고신뢰 시크릿 패턴 2종 ──────────────────────────
# git diff --cached 로 이번 커밋에 포함되는(추가/수정) 파일만 검사한다. 삭제 파일 제외.
# 목록을 임시 파일에 담고 while-read를 '현재 셸'에서(리다이렉션으로) 돌려 add_reason의
# FAILED/REASONS 변경이 유지되게 한다(파이프로 넣으면 서브셸이라 변경이 소실됨).
STAGED_LIST=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
if [ -n "$STAGED_LIST" ]; then
  TMP_LIST=$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/apphub-precommit.$$")
  printf '%s\n' "$STAGED_LIST" > "$TMP_LIST"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    fpath="$ROOT/$f"
    [ -f "$fpath" ] || continue
    # 바이너리 제외: grep -I 는 바이너리 파일을 비매치 처리하므로, 텍스트 여부를 이걸로 판정.
    if ! grep -Iq . "$fpath" 2>/dev/null; then
      continue
    fi
    # AWS Access Key ID: AKIA + 16 대문자/숫자.
    if grep -qE 'AKIA[0-9A-Z]{16}' "$fpath" 2>/dev/null; then
      add_reason "AWS Access Key로 보이는 값이 '$f'에 있어요. 시크릿은 코드에 넣지 말고 환경변수로 주입하세요."
    fi
    # PEM private key 헤더.
    if grep -qE -- '-----BEGIN [A-Z ]*PRIVATE KEY-----' "$fpath" 2>/dev/null; then
      add_reason "개인키(PEM PRIVATE KEY)로 보이는 값이 '$f'에 있어요. 키 파일을 커밋하지 마세요."
    fi
  done < "$TMP_LIST"
  rm -f "$TMP_LIST"
fi

# ── 결과 보고 ────────────────────────────────────────────────────────────────
if [ "$FAILED" -ne 0 ]; then
  printf '\n[AppHub 배포 표준] 커밋을 멈췄어요. 아래 항목을 고쳐 주세요:\n\n'
  printf '%s\n' "$REASONS"
  printf 'Kiro에게 "배포 표준에 맞춰줘"라고 요청하면 자동으로 고쳐줄 수 있어요.\n'
  printf '(이 검사는 보조 수단이고, 최종 판정은 플랫폼의 배포 전 검증이 합니다.)\n\n'
  exit 1
fi

exit 0
